# Copy to .env and set a real password. .env is git-ignored; this file is committed.

# Used by docker-compose.yml to create the database
POSTGRES_USER=predmaint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=predmaint
POSTGRES_PORT=5432

# Used by the app, Alembic and the integration tests (must match the values above)
DATABASE_URL=postgresql+psycopg://predmaint:change-me@localhost:5432/predmaint

# Published ports of the Docker stack (docker compose up); change them if already in use
API_PORT=8000
DASHBOARD_PORT=8501
